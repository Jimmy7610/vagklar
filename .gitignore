node_modules
dist
dev-dist
coverage
*.local
.DS_Store
.vite

# Emitted by a stray `tsc` run; Vite would resolve these before the .ts sources.
/vite.config.js
/vitest.setup.js
*.tsbuildinfo

# Local theory/reference source documents.
# Licensed third-party material — used with permission as curriculum source,
# but never committed, never bundled and never published. See
# docs/SOURCES-AND-RIGHTS.md.
references/*.pdf
references/*.epub
references/**/extracted/
# Per-page text cache built by scripts/extract-source-pages.py for the
# source-page audit. Derived from the licensed source, so it stays local too.
references/.page-text.json
# Diagram crops rendered from the licensed source by
# scripts/extract-source-diagrams.py. Inputs to the optimiser, never shipped
# as-is — only the optimised WebP files reach the app.
references/extracted/diagrams/

# Scratch output from source-extraction tooling.
/tmp-extract/

# Local reviewer UI, regenerated by `npm run report:verification`. It embeds the
# whole question bank as HTML, so it is built on demand rather than committed.
/review/
